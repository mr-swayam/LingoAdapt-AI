# Copy this file to backend/.env and frontend/.env.local and fill in real values.
# Never commit the resulting .env files.

# --- Backend (backend/.env) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lingoadapt:lingoadapt@localhost:5432/lingoadapt_dev
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Auth (Supabase or equivalent)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI provider (server-side only, never exposed to the client)
AI_PROVIDER=none
AI_API_KEY=
AI_DEFAULT_MODEL=
# Speech-to-text/text-to-speech (Phase 8) use fixed Groq models
# (whisper-large-v3-turbo, canopylabs/orpheus-v1-english) rather than a
# second configurable env var - see app/ai/groq_provider.py. The TTS model
# requires one-time terms acceptance by the account/org admin at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# before any /audio/speech call succeeds (STT has no such requirement).

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
