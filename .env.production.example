# Template for PRODUCTION environment variables (Phase 14). Copy the
# values you need into your hosting platform's environment/secrets UI -
# never into a committed file. This file itself contains no real values,
# only placeholders and generation instructions.
#
# See DEPLOYMENT_RUNBOOK.md for the full step-by-step deployment guide
# this file supports.

# ============================================================
# Backend (set on your backend host - Railway/Render/Fly/VPS/etc.)
# ============================================================

ENVIRONMENT=production

# From your managed Postgres provider. Must use the postgresql+psycopg://
# scheme (SQLAlchemy dialect prefix) even though the provider will give you
# a plain postgresql:// or postgres:// URL - add "+psycopg" after
# "postgresql".
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# From your managed Redis provider.
REDIS_URL=redis://:PASSWORD@HOST:6379

# REQUIRED - the app refuses to start in production without a real value
# here (app/core/config.py). Generate one, do not make one up by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# REQUIRED - your real frontend origin(s), comma-separated, no trailing
# slash. The app refuses to start in production if this still contains
# "localhost" (app/core/config.py). Example:
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=

# Leave as-is unless you have a specific reason to change token lifetimes.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Not currently used by the app (no Supabase-backed auth path is wired
# up - this project uses its own JWT/bcrypt auth, app/core/security.py).
# Leave blank; kept here only in case a future phase adds Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Your Groq API key. Use a key dedicated to production, separate from any
# development key - see DEPLOYMENT_RUNBOOK.md's "AI provider" section for
# why, and for the one-time TTS terms-acceptance step this account needs.
AI_PROVIDER=groq
AI_API_KEY=
AI_DEFAULT_MODEL=openai/gpt-oss-120b

# Optional - error monitoring stays disabled (safe no-op) until this is
# set. Get a DSN by creating a free Sentry project.
SENTRY_DSN=

# ============================================================
# Frontend (set on your frontend host - Vercel/Netlify/etc.)
# ============================================================

# Your deployed backend's public URL, with the /api/v1 suffix.
NEXT_PUBLIC_API_BASE_URL=https://your-backend-host.example.com/api/v1

# Not currently used (see SUPABASE_* note above) - leave blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
